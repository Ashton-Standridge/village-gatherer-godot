; Engine configuration file.
config_version=5

[application]

config/name="Village Gatherer"
config/description="Idle village gatherer — sell, upgrade, build. Portrait pixel-art."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"
PixelArt="*res://scripts/pixel_art.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]

textures/vram_compression/import_etc2_astc=true

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.18, 1)

[input_devices]

pointing/emulate_touch_from_mouse=true
